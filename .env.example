# Copy to .env and fill in STRONG local values. Never commit .env.
# SQL Server (Developer edition in container) requires 8+ chars with
# upper, lower, digit and symbol.
DB_PASSWORD=ChangeMe!234567890abc

# JWT signing key: random 32+ char string. Generate with:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_KEY=REPLACE-WITH-RANDOM-64-CHAR-STRING-local-dev-only

# Host port for the storefront (nginx). 8080 verified free on 2026-10-13.
HOST_PORT=8080

# JWT lifetimes (defaults match appsettings; override when needed)
# JWT_ISSUER=ecommerce-api
# JWT_AUDIENCE=ecommerce-spa
